<?xml version="1.0" encoding="utf-8"?>
<!--
    FocusGuard — res/layout/activity_main.xml
    ════════════════════════════════════════════════════════════════════════
    Dashboard Screen

    Visual hierarchy (top → bottom):
      1. TopAppBar — App name + settings shortcut
      2. Scrollable content:
         a. Greeting text ("Good morning")
         b. LARGE circular progress ring — "Screen Time Today"
            Center text: formatted hours/mins + focus status label
         c. Service status chip (active / paused)
         d. "Today's Highlights" section — 2×2 stat cards
         e. "Recent Activity" header + last 3 sessions
      3. Bottom NavigationBar — Home / Focus Breakers / AI Settings

    Layout strategy:
      - CoordinatorLayout root for AppBar scroll behavior
      - NestedScrollView for the full content area
      - ConstraintLayout inside for precise positioning of the ring + cards
      - MaterialCardView for each stat block (elevation + tonal surface)

    The CircularProgressIndicator is the visual anchor of this screen.
    At 240dp diameter it commands attention without overwhelming.
    Color dynamically changes: green (good) → amber (caution) → rose (high risk)
    ════════════════════════════════════════════════════════════════════════
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- ══════════════════════════════════════════════════════════════════
         TOP APP BAR
         ══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/nested_scroll_view">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:menu="@menu/menu_main" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         SCROLLABLE CONTENT
         ══════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <!-- ── Greeting Text ── -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dashboard_greeting_morning"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Good morning ☀️" />

            <!-- ══════════════════════════════════════════════════════
                 SCREEN TIME RING — The visual heart of the dashboard

                 The CircularProgressIndicator is wrapped in a FrameLayout
                 so we can layer text directly in its center.
                 The indicator track color and active color are set
                 programmatically in MainActivity.java based on risk level.
                 ══════════════════════════════════════════════════════ -->
            <FrameLayout
                android:id="@+id/frame_ring_container"
                android:layout_width="256dp"
                android:layout_height="256dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_greeting">

                <!-- The circular ring itself -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_screen_time"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:progress="0"
                    android:max="100"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="14dp"
                    app:indicatorSize="256dp" />

                <!-- Center content: time + status stacked vertically -->
                <LinearLayout
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Label: "Screen Time Today" -->
                    <TextView
                        android:id="@+id/tv_ring_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_time_ring_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:gravity="center" />

                    <!-- Large time display: "2h 34m" -->
                    <TextView
                        android:id="@+id/tv_screen_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.FocusGuard.ScreenTimeDisplay"
                        android:textColor="?attr/colorOnBackground"
                        android:gravity="center"
                        tools:text="2h 34m" />

                    <!-- Thin divider line -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Focus status: "You're doing great! 🎯" -->
                    <TextView
                        android:id="@+id/tv_focus_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorPrimary"
                        android:gravity="center"
                        android:maxLines="2"
                        tools:text="You're doing great! 🎯" />

                </LinearLayout>

            </FrameLayout>

            <!-- ── Focus Status Sub-label (below the ring) ── -->
            <TextView
                android:id="@+id/tv_focus_status_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/frame_ring_container"
                tools:text="Keep up the good work today." />

            <!-- ── Service Status Chip ── -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_active"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:chipBackgroundColor="@color/md_theme_light_primaryContainer"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="true"
                style="@style/Widget.Material3.Chip.Assist"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_focus_status_sub" />

            <!-- ══════════════════════════════════════════════════════
                 TODAY'S HIGHLIGHTS — 2x2 grid of stat cards
                 ══════════════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tv_highlights_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/highlights_section_title"
                android:textAppearance="@style/TextAppearance.FocusGuard.SectionHeader"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chip_service_status" />

            <!-- Grid row 1: Most Used App | Time on Distractions -->
            <LinearLayout
                android:id="@+id/row_stats_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_highlights_header">

                <!-- Card: Most Used App -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_most_used_app"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Style.FocusGuard.Card"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/highlight_most_used_app"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- App icon + name inline -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_most_used_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_app_placeholder" />

                            <TextView
                                android:id="@+id/tv_most_used_app"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Instagram" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_most_used_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="1h 12m today" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Time on Distracting Apps -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_distraction_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Style.FocusGuard.Card"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/highlight_time_on_distractions"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tv_distraction_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="?attr/colorTertiary"
                            tools:text="48m" />

                        <TextView
                            android:id="@+id/tv_distraction_time_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="of your day" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Grid row 2: FocusGuard Helped | Focus Score -->
            <LinearLayout
                android:id="@+id/row_stats_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/row_stats_top">

                <!-- Card: Times FocusGuard Helped -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_blocks_today"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Style.FocusGuard.Card"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/highlight_blocks_today"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tv_blocks_today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="?attr/colorPrimary"
                            tools:text="3" />

                        <TextView
                            android:id="@+id/tv_blocks_today_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="times today" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Focus Score -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_focus_score"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Style.FocusGuard.Card"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/highlight_focus_score"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tv_focus_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="84" />

                        <TextView
                            android:id="@+id/tv_focus_score_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="Good 👍" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════
                 BOTTOM SPACER — ensures content doesn't hide behind nav bar
                 ══════════════════════════════════════════════════════ -->
            <View
                android:id="@+id/bottom_spacer"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/row_stats_bottom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTTOM NAVIGATION BAR
         Anchored to the bottom of the CoordinatorLayout.
         ══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
