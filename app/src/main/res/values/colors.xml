    <color name="md_theme_light_onPrimary">#FFFFFF</color>            <!-- Text on primary -->
    <color name="md_theme_light_primaryContainer">#E3DFFF</color>     <!-- Chip background, subtle fill -->
    <color name="md_theme_light_onPrimaryContainer">#12006E</color>   <!-- Text on primary container -->

    <color name="md_theme_dark_primary">#C4BFFF</color>
    <color name="md_theme_dark_onPrimary">#2300AC</color>
